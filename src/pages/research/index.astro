---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import Icon from '../../components/Icon.astro';
import CollectionFilter from '../../components/CollectionFilter.astro';

const items = (await getCollection('research'))
  .sort((a, b) => b.data.year - a.data.year);

const tags = [...new Set(items.flatMap(item => item.data.tags))]
  .sort((a, b) => a.localeCompare(b));
---

<BaseLayout title="Research — Wei-Hao Lee">
  <PageIntro
    eyebrow="Research"
    title="Models for connected questions."
    lede="Research programs, working ideas, and selected publications—each explained visually and without assuming the reader already knows the vocabulary."
  />

  <section class="page-shell section collection-section" style="padding-top: 0">
    <CollectionFilter tags={tags} itemLabel="research entry" />

    <div class="card-list">
      {items.map(item => (
        <a
          class="list-card"
          data-filter-item
          data-tags={JSON.stringify(item.data.tags)}
          href={`/research/${item.id}/`}
        >
          <span class="year">{item.data.year} · {item.data.status}</span>
          <div>
            <h3>{item.data.title}</h3>
            <p>{item.data.summary}</p>
            <div class="tag-row">
              {item.data.tags.map(tag => <span class="tag">{tag}</span>)}
            </div>
          </div>
          <Icon name="arrow" />
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
