---
import Icon from './Icon.astro';
const links = [
  ['/', 'Home', 'home'], ['/about', 'About', 'about'], ['/research', 'Research', 'research'],
  ['/blog', 'Blog', 'blog'], ['/packages', 'Packages', 'package'], ['/gallery', 'Gallery', 'gallery']
] as const;
const current = Astro.url.pathname;
---
<header class="site-header" data-header>
  <a class="brand" href="/" aria-label="Wei-Hao Lee, home">
    <svg class="brand-mark" viewBox="0 0 60 34" aria-hidden="true">
      <g class="brand-monogram">
        <path d="M2 4.5 7.5 29 14 15l6.5 14L26 4.5M32 4.5v24.5M32 17h11M43 4.5V29M49 4.5V29h9" />
      </g>
      <g class="brand-connector">
        <path d="M2 4.5 32 4.5 58 29M7.5 29 32 17 49 4.5M20.5 29H43L58 29M14 15 43 17 49 29" />
      </g>
      <g class="brand-nodes">
        <circle cx="2" cy="4.5" r="1.55"/><circle cx="7.5" cy="29" r="1.55"/><circle cx="14" cy="15" r="1.8"/><circle cx="20.5" cy="29" r="1.55"/><circle cx="26" cy="4.5" r="1.55"/>
        <circle cx="32" cy="4.5" r="1.55"/><circle cx="32" cy="17" r="1.8"/><circle cx="32" cy="29" r="1.55"/><circle cx="43" cy="4.5" r="1.55"/><circle cx="43" cy="17" r="1.8"/><circle cx="43" cy="29" r="1.55"/>
        <circle cx="49" cy="4.5" r="1.55"/><circle cx="49" cy="29" r="1.8"/><circle cx="58" cy="29" r="1.55"/>
      </g>
    </svg>
  </a>
  <nav class="nav-dock" aria-label="Primary navigation">
    {links.map(([href, label, icon]) => <a href={href} data-label={label} class:list={{ active: current === href || (href !== '/' && current.startsWith(href)) }} aria-current={current === href || (href !== '/' && current.startsWith(href)) ? 'page' : undefined}><Icon name={icon} /><span>{label}</span></a>)}
    <button class="theme-toggle" type="button" data-theme-toggle data-label="Change theme">
      <Icon name="sun" />
      <span class="mode-cue" aria-hidden="true"><span></span><span></span><span></span></span>
    </button>
  </nav>
</header>
<script>
  const header = document.querySelector('[data-header]');
  const update = () => header?.classList.toggle('is-scrolled', window.scrollY > 80);
  update(); addEventListener('scroll', update, { passive: true });
</script>
